PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration (Sequelize)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:ayma12345@localhost:5432/chulha_db

# Individual PG variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chulha_db
DB_USER=postgres
DB_PASSWORD=ayma12345

# JWT Secret for Authentication
JWT_SECRET=chulha_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

# Upload destination
UPLOAD_DIR=server/uploads

